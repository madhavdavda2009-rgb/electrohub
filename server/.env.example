# ==============================================================================
# StyleHub Environment Configuration Template
# Copy this file to .env in the same directory (server/.env) and fill in your values
# ==============================================================================

# Server Port (default: 5000)
PORT=5000

# Database Connection
# To use Supabase (PostgreSQL), provide your connection string from:
# Supabase Project Dashboard -> Project Settings -> Database -> Connection string (URI) / Connection Pooling
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# JWT Secret for User & Admin Authentication (replace with a long random string)
JWT_SECRET=your_jwt_secret_key_here

# UPI Payments (Optional)
UPI_ID=yourname@upi
UPI_PAYEE_NAME=StyleHub

# Razorpay Card Payments (Optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
